generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model DeviceIdentifier {
  id           String        @id @default(uuid(7)) @db.Uuid
  name         String        @unique @db.VarChar(255)
  /// Board and sensor wiring design (see src/lib/wiring); null means the default layout.
  wiring       Json?
  createdAt    DateTime      @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt    DateTime      @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  plant        Plant?
  sensorValues SensorValue[]

  @@map("device_identifiers")
}

model Plant {
  id                 BigInt           @id @default(autoincrement())
  deviceIdentifierId String           @unique @map("device_identifier_id") @db.Uuid
  name               String           @db.VarChar(255)
  moistureLevelMin   Float            @map("moisture_level_min")
  moistureLevelMax   Float            @map("moisture_level_max")
  humidity           Float
  temperature        Float
  lightIntensity     Float            @map("light_intensity")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt          DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  deviceIdentifier   DeviceIdentifier @relation(fields: [deviceIdentifierId], references: [id], onDelete: Cascade)

  @@map("plants")
}

/// A null reading means that sensor was not detected or is defective.
model SensorValue {
  id                 BigInt           @id @default(autoincrement())
  deviceIdentifierId String           @map("device_identifier_id") @db.Uuid
  moistureLevel      Float?           @map("moisture_level")
  humidity           Float?
  temperature        Float?
  lightIntensity     Float?           @map("light_intensity")
  isIrrigating       Boolean          @default(false) @map("is_irrigating")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt          DateTime         @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  deviceIdentifier   DeviceIdentifier @relation(fields: [deviceIdentifierId], references: [id], onDelete: Cascade)

  @@index([deviceIdentifierId, createdAt(sort: Desc)])
  @@map("sensor_values")
}

enum UserType {
  farmer
  admin
  maintenance

  @@map("user_type_enum")
}

model User {
  id              BigInt    @id @default(autoincrement())
  name            String    @db.VarChar(255)
  email           String    @unique @db.VarChar(255)
  emailVerifiedAt DateTime? @map("email_verified_at") @db.Timestamp(0)
  password        String    @db.VarChar(255)
  userType        UserType  @default(farmer) @map("user_type")
  rememberToken   String?   @map("remember_token") @db.VarChar(100)
  createdAt       DateTime  @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt       DateTime  @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  roles           UserRole[]

  @@map("users")
}

/// A named set of permissions (see src/lib/auth/rbac.ts for the permission catalog).
model Role {
  id          BigInt     @id @default(autoincrement())
  name        String     @unique @db.VarChar(255)
  description String?    @db.VarChar(500)
  permissions String[]   @default([])
  createdAt   DateTime   @default(now()) @map("created_at") @db.Timestamp(0)
  updatedAt   DateTime   @default(now()) @updatedAt @map("updated_at") @db.Timestamp(0)
  users       UserRole[]

  @@map("roles")
}

/// A user can hold several roles; their permissions are the union of the roles' permissions.
model UserRole {
  userId BigInt @map("user_id")
  roleId BigInt @map("role_id")
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  role   Role   @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@index([roleId])
  @@map("user_roles")
}
