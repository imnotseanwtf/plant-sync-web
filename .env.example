# =================================================================
# Authentication
# =================================================================
# Secret used to sign the session cookie (min 32 chars). Generate one with:
#   openssl rand -base64 48
# Users are stored in the `users` table (bcrypt hashes from the Laravel app work as-is).

AUTH_SECRET=

# Set to your public URL (e.g. https://plants.example.com). An https URL marks the
# session cookie `Secure`; leave unset when serving plain HTTP on a LAN.
NEXT_PUBLIC_APP_URL=


# =================================================================
# Database (Prisma / PostgreSQL)
# =================================================================
# Tables are created by `bunx prisma migrate deploy` (the Docker image runs it on start).
# For a hosted database add `sslmode=verify-full` to silence the pg SSL-mode warning.

DATABASE_URL="postgresql://plant_sync_web:secret@127.0.0.1:5432/plant_sync_web?schema=public"
# Optional: non-pooled URL used only for migrations (Neon/Supabase/Vercel Postgres pooled hosts)
DIRECT_URL=

# =================================================================
# ESP32 device API
# =================================================================
# Optional shared secret for /api/store-sensor-values and
# /api/irrigation-control. When set, devices must send `X-Device-Key`.
# Leave empty to keep the endpoints open (legacy firmware).

DEVICE_API_KEY=

# =================================================================
# Seeding (`bun run db:seed`; runs automatically on Vercel builds and in Docker)
# =================================================================
# Login created by the seeder, plus demo devices, plants and readings.
SEED_USER_NAME="Admin"
SEED_USER_EMAIL="admin@example.com"
SEED_USER_PASSWORD="password"
# The seeder runs after migrations on every Vercel build / container start (idempotent: it never
# overwrites an existing user). Set to false to skip it.
SEED_DATABASE=

# =================================================================
# Build Configuration
# =================================================================
# Set to 'true' when deploying with Docker or self-hosting on a VPS.
# This enables Next.js standalone output mode for smaller deployments.

BUILD_STANDALONE=    # Example: "true"

# =================================================================
# Important Notes:
# =================================================================
# 1. Rename this file to '.env' for local development
# 2. Never commit the actual '.env' file to version control
# 3. Make sure to replace all placeholder values with real ones
# 4. Keep your secret keys private and never share them
